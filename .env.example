# Copy to .env. Everything is optional except the database.
DATABASE_URL=postgresql://kotha:kotha@localhost:5432/kotha

# Claude. Leave empty to run the offline (rule-based) agent.
ANTHROPIC_API_KEY=
KOTHA_MODEL=claude-sonnet-5-5

# Embeddings: hash (local, no network) or voyage (multilingual, cross-lingual search).
KOTHA_EMBEDDER=hash
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-multilingual-2

# Real courier endpoint (GET {url}/track/{tracking_id}). Empty = built-in mock courier.
COURIER_API_URL=
COURIER_API_KEY=

KOTHA_DEFAULT_SHOP=demo
KOTHA_TZ=Asia/Dhaka
